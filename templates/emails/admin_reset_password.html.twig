{% extends 'email.html.twig' %}

{% block content %}
    <spacer size="16"></spacer>
    <h1>Bonjour {{ user.fullname }} ! 👋</h1>
    <p class="lead">Un administrateur a mis à jour le mot de passe de votre compte sur {{ app_name }}.</p>
    
    <spacer size="16"></spacer>

    <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin: 16px 0;">
        <p style="margin: 0 0 8px 0; font-size: 14px; color: #475569;"><strong>Vos identifiants de connexion :</strong></p>
        <p style="margin: 0 0 4px 0; font-size: 14px;"><strong>Identifiant (Email) :</strong> {{ user.email }}</p>
        <p style="margin: 0; font-size: 14px;"><strong>Nouveau mot de passe :</strong> <code style="background: #e2e8f0; padding: 3px 8px; border-radius: 4px; font-family: monospace; font-weight: bold; color: #0f172a;">{{ plainPassword }}</code></p>
    </div>

    <spacer size="16"></spacer>

    <center>
        <button href="{{ loginUrl }}" class="primary">Se connecter à {{ app_name }}</button>
    </center>

    <spacer size="24"></spacer>

    <p style="font-size: 12px; color: #64748b;">
        Pour des raisons de sécurité, nous vous invitons à personnaliser ce mot de passe dès votre connexion depuis votre espace profil.
    </p>

    <spacer size="16"></spacer>
    
    <p>À très bientôt sur la plateforme,<br><strong>L'équipe {{ app_name }}</strong></p>
{% endblock %}
